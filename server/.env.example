PORT=4317
HOST=127.0.0.1
CLAUDE_PATH=claude
# Codex 默认优先使用桌面应用自带运行时，回退到 PATH 中的 codex；无需额外API key
# CODEX_PATH=/absolute/path/to/codex
# CODEX_MODEL=  # 留空沿用本机 Codex 的模型配置
MODEL=
# 可选；不设置则使用 Cursor 账号登录态（npm run cursor:login -w server）
# CURSOR_API_KEY=your_key_here
CURSOR_MODEL=composer-2.5
# WORKSPACES_DIR=

# 日照：与 Grasshopper「HB Direct Sun Hours」一致（lbt-recipes + Radiance）
# 仓库内已配置 vendor Radiance + .venv 时可省略；LB 模式请设 SDD_SUNLIGHT_USE_RADIANCE=0
# SDD_SUNLIGHT_USE_RADIANCE=1
# SDD_SUNLIGHT_PYTHON=python/sunlight/.venv/bin/python3
# SDD_SUNLIGHT_RADIANCE_BIN=python/sunlight/vendor/radiance/radiance/bin
